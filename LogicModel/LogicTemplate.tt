using PluginSupport;

namespace LogicModel
{
    public partial class PluginLogic
    {
        static partial void AddTreeNodeItems(List<TreeNode> items)
        {
            TreeNode nodesGroup;
<#
    var inputCount = 8;
    var types = new Tuple<string, string, string, string>[] { new("Or", "1", "Дизъюнкция", "||"), new("And", "&", "Конъюнкция", "&&") };
    foreach (var type in types)
    {
#>
            nodesGroup = new TreeNode("<#= type.Item3 #>") { Tag = typeof(<#= type.Item1 #>2) };
            items.Add(nodesGroup);
<#
        for (var i = 2; i <= inputCount; i++)
        {
#>
            nodesGroup.Nodes.Add(new TreeNode("<#= type.Item1.ToUpper() #><#= i #>") { Tag = typeof(<#= type.Item1 #><#= i #>) });
<#
        }
    }
#>
        }
    }

<#
    foreach (var type in types)
    for (var i = 2; i <= inputCount; i++)
    {
        List<string> holderValues = [];
        List<string> holderInits = [];
        List<string> holderInputNames = [];
        List<string> holderOutputNames = [];
        for (var j = 1; j <= i; j++)
        {
            holderValues.Add("false");
            holderInits.Add("new PinInput { }");
            holderInputNames.Add("\"\"");
        }
#>
    public class <#= type.Item1 #><#= i #> : Func
    {
        public <#= type.Item1 #><#= i #>()
        {
            FuncName = "<#= type.Item2 #>";
            FuncDesc = "<#= type.Item3 #>";
            Inputs = [<#= string.Join(", ", holderInits) #>];
            Outputs = [new PinOutput { }];
            CalculateHeight();
        }

        public override <#= type.Item1 #><#= i #> DeepClone()
        {
            return new <#= type.Item1 #><#= i #>()
            {
                Location = Location,
                FuncName = FuncName,
                FuncDesc = FuncDesc,
                Inputs = [.. Inputs.Select(x => x.DeepClone())],
                Outputs = [.. Outputs.Select(x => x.DeepClone())],
            };
        }

        public override void Calculate()
        {
            if (Inputs.Length > 0)
            {
                var result = (Inputs[0].Value > 0) ^ Inputs[0].IsInverted;
                for (int i = 1; i < Inputs.Length; i++)
                    result = result <#= type.Item4 #> ((Inputs[i].Value > 0) ^ Inputs[i].IsInverted);
                result ^= Outputs[0].IsInverted;
                if (Outputs.Length > 0 && (Outputs[0].Value > 0) != result)
                {
                    Outputs[0].Value = result ? 1 : 0;
                    base.Calculate();
                }
            }
        }

   }

<#
    }
#>
