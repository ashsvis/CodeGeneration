<#@ template debug="false" hostspecific="false" language="C#" #>
<#@ output extension=".cs" #>
<#@ assembly name="System.Core" #>
<#@ import namespace="System" #>
<#@ import namespace="System.Linq" #>
<#@ import namespace="System.Text" #>
<#@ import namespace="System.Collections.Generic" #>
using PluginSupport;

namespace LogicModel
{
    public partial class PluginLogic
    {
        static partial void AddTreeNodeCompareItems(TreeNodeCollection items)
        {
<#
    var compareTypes = new Tuple<string, string, string, string>[] 
    { 
        new("Eq", "==", "Элемент \\\"Сравнение\\\"", "Math.Abs(Inputs[0].Value - Inputs[1].Value) < double.Epsilon"),
        new("Ne", "!=", "Элемент \\\"Не равно\\\"", "!(Math.Abs(Inputs[0].Value - Inputs[1].Value) < double.Epsilon)"),
        new("Gt", ">", "Элемент \\\"Больше\\\"", "Inputs[0].Value > Inputs[1].Value"),
        new("Ge", ">=", "Элемент \\\"Больше или равно\\\"", "Inputs[0].Value >= Inputs[1].Value"),
        new("Lt", "<", "Элемент \\\"Меньше\\\"", "Inputs[0].Value < Inputs[1].Value"),
        new("Le", "<=", "Элемент \\\"Меньше или равно\\\"", "Inputs[0].Value <= Inputs[1].Value"),
    };
    foreach (var type in compareTypes)
    {
#>
            items.Add(new TreeNode("<#= type.Item3 #>") { Tag = typeof(<#= type.Item1 #>) });
<#
    }
#>
        }
    }

<#
    foreach (var type in compareTypes)
    {
#>
    public class <#= type.Item1 #> : Func, IFuncPresenter
    {
        public <#= type.Item1 #>()
        {
            FuncName = "<#= type.Item2 #>";
            FuncDesc = "<#= type.Item3 #>";
            Inputs = [new PinInput { Kind = ValueKind.Analog }, new PinInput { Kind = ValueKind.Analog }];
            Outputs = [new PinOutput { Kind = ValueKind.Digital }];
            CalculateHeight();
        }

        public bool IsPresent => <#= (type.Item2 == "==").ToString().ToLower()  #>;

        public override <#= type.Item1 #> DeepClone()
        {
            return new <#= type.Item1 #>()
            {
                id = Id,
                Index = this.Index,
                Location = Location,
                FuncName = FuncName,
                FuncDesc = FuncDesc,
                Inputs = [.. Inputs.Select(x => x.DeepClone())],
                Outputs = [.. Outputs.Select(x => x.DeepClone())],
            };
        }

        public override AllowedFuncProperties AllowedFuncProperties => AllowedFuncProperties.All ^
                (AllowedFuncProperties.PinInverted);

        public override void Calculate()
        {
            if (Inputs.Length > 0)
            {
                var result = <#= type.Item4 #>;
                if (Outputs.Length > 0 && (Outputs[0].Value > 0) != result)
                {
                    Outputs[0].Value = result ? 1 : 0;
                    Transfer();
                }
            }
        }
    }

<#
    }
#>
}